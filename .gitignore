# Preserve the historical acceptance evidence migrated with the plugin.
**/TestResults/
!/TestResults/
/TestResults/*
!/TestResults/G3/
!/TestResults/G3.1/
!/TestResults/G4/
!/TestResults/G8/
!/TestResults/G9/
!/TestResults/G10/
!/TestResults/G11/
!/TestResults/Phase4/
*.trx
*.coverage
*.coveragexml

