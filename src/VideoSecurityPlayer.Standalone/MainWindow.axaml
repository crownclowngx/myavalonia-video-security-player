<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VideoSecurityPlayer.Standalone.MainWindow" Width="1280" Height="850" MinWidth="640" MinHeight="480"
        Title="加密视频工具 — 独立调试" SizeChanged="OnToolLayoutChanged">
  <Grid>
  <DockPanel>
    <WrapPanel DockPanel.Dock="Top" Margin="12">
      <ComboBox x:Name="FeatureSelector" MinWidth="210" ToolTip.Tip="每个标签独立运行，可重复打开同一功能" />
      <Button x:Name="OpenButton" Content="打开功能" Click="OpenFeature" />
      <ComboBox x:Name="ToolSelector" MinWidth="180" />
      <Button Content="打开工具" Click="OpenTool" />
    </WrapPanel>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="12,6" TextWrapping="Wrap"
               Text="独立调试窗口 · Host 加载、Dock 和工作流联调请运行专项验收。" />
    <Grid x:Name="WorkspaceLayout" ColumnDefinitions="*,0" RowDefinitions="*,0">
      <TabControl x:Name="Documents" />
      <Border x:Name="ToolPane" Grid.Column="1" IsVisible="False">
        <DockPanel>
          <Button DockPanel.Dock="Top" Content="隐藏工具" Click="HideTool" HorizontalAlignment="Right" />
          <ContentControl x:Name="ToolContent" HorizontalContentAlignment="Stretch" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
  <Border x:Name="FullscreenLayer" IsVisible="False" Background="{DynamicResource AppPanelBrush}">
    <ContentControl x:Name="FullscreenContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Border>
  </Grid>
</Window>
