<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VideoSecurityPlayer.ViewModels.SecretVideoPlayer.Library"
             x:Class="VideoSecurityPlayer.Views.SecretVideoPlayer.Library.LibraryPlaybackFooterView"
             x:DataType="vm:LibraryPlaybackViewModel">
  <Border Classes="TaskFooter" Padding="0,7,0,0">
    <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="5">
      <TextBlock IsVisible="{Binding Owner.Browser.HasFolder}" Text="{Binding Owner.Browser.StatusMessage}" Classes="Caption" TextWrapping="Wrap" />
      <ProgressBar IsVisible="{Binding Owner.Browser.IsScanning}" IsIndeterminate="{Binding Owner.Browser.IsScanning}" Height="3" />
      <Border IsVisible="{Binding Owner.IsPasswordPromptOpen}" AutomationProperties.Name="播放密码输入">
        <StackPanel Spacing="5">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
            <Grid>
              <TextBox Text="{Binding Owner.Password}" PasswordChar="●" IsVisible="{Binding !Owner.ShowPassword}"
                       PlaceholderText="输入播放密码" Classes="CompactInput" AutomationProperties.Name="播放密码" />
              <TextBox Text="{Binding Owner.Password}" IsVisible="{Binding Owner.ShowPassword}"
                       PlaceholderText="输入播放密码" Classes="CompactInput" AutomationProperties.Name="可见播放密码" />
            </Grid>
            <Button Grid.Column="1" Content="显示/隐藏" Command="{Binding Owner.TogglePasswordVisibilityCommand}" Classes="CompactButton" />
          </Grid>
          <WrapPanel>
            <Button Content="{Binding Owner.PasswordActionText}" Command="{Binding Owner.ConfirmPasswordCommand}" Classes="CompactButton accent DocumentActionButton" />
            <Button Content="取消" Command="{Binding Owner.CancelOpeningCommand}" Classes="CompactButton" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding Owner.StatusMessage}" Classes="StatusText" TextWrapping="Wrap" />
      <Button Content="取消加载" Command="{Binding Owner.CancelOpeningCommand}" IsVisible="{Binding Owner.IsOpening}" Classes="CompactButton" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
        <Button Content="{Binding Owner.PlayButtonText}" Command="{Binding Owner.PlaySelectedCommand}"
                IsEnabled="{Binding Owner.PlayerViewModel.IsPlaybackAvailable}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Classes="CompactButton accent" MinHeight="36" IsDefault="{Binding !Owner.IsPasswordPromptOpen}"
                AutomationProperties.Name="播放所选视频" />
        <Button Grid.Column="1" Content="更多" Classes="CompactButton">
          <Button.Flyout>
            <Flyout>
              <StackPanel Spacing="5">
                <Button Content="从头播放" Command="{Binding Owner.PlayFromStartCommand}" Classes="CompactButton" />
                <Button Content="仅加载" Command="{Binding Owner.LoadSelectedCommand}" Classes="CompactButton" />
                <Button Content="播放密码" Command="{Binding Owner.EditPlaybackPasswordCommand}" Classes="CompactButton" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
