<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VideoSecurityPlayer.Converters.SecretVideoPlayer"
             xmlns:vm="clr-namespace:VideoSecurityPlayer.ViewModels.SecretVideoPlayer.Library"
             xmlns:library="clr-namespace:VideoSecurityPlayer.Business.SecretVideoPlayer.Library"
             x:Class="VideoSecurityPlayer.Views.SecretVideoPlayer.Library.LibrarySettingsView"
             x:DataType="vm:LibraryLayoutViewModel">
  <UserControl.Resources>
    <converters:VideoLibraryEnumDisplayConverter x:Key="LibraryEnumDisplay" />
  </UserControl.Resources>
  <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="4">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBlock Text="{Binding Owner.Browser.FolderPath}" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Owner.Browser.FolderPath}" VerticalAlignment="Center" Classes="Caption" />
        <Button Grid.Column="1" Content="选择文件夹" Click="OnBrowseFolderClick" IsEnabled="{Binding !Owner.IsOpening}"
                Classes="CompactButton" AutomationProperties.Name="选择视频文件夹" />
      </Grid>
      <WrapPanel>
        <Button Content="最近目录" Click="OnRecentFoldersClick" Classes="CompactButton" Margin="0,0,4,0" />
        <Button Content="继续观看" Command="{Binding Owner.Browser.ShowContinueWatchingCommand}" Classes="CompactButton" Margin="0,0,4,0" />
        <Button Content="定位当前" Command="{Binding Owner.LocateCurrentVideoCommand}" Classes="CompactButton" />
      </WrapPanel>
      <Grid ColumnDefinitions="*,74,110" ColumnSpacing="4">
            <ComboBox Grid.Column="0" Classes="CompactInput" ItemsSource="{Binding Owner.Browser.AvailableSortFields}"
                      SelectedItem="{Binding Owner.Browser.SortField}" ToolTip.Tip="排序字段">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="library:VideoLibrarySortField"><TextBlock Text="{Binding Converter={StaticResource LibraryEnumDisplay}}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="1" Classes="CompactInput" ItemsSource="{Binding Owner.Browser.AvailableSortDirections}"
                      SelectedItem="{Binding Owner.Browser.SortDirection}" ToolTip.Tip="排序方向">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="library:VideoLibrarySortDirection"><TextBlock Text="{Binding Converter={StaticResource LibraryEnumDisplay}}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="2" Classes="CompactInput" ItemsSource="{Binding Owner.Browser.AvailableStatusFilters}"
                      SelectedItem="{Binding Owner.Browser.StatusFilter}" ToolTip.Tip="播放状态筛选">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="library:VideoLibraryStatusFilter"><TextBlock Text="{Binding Converter={StaticResource LibraryEnumDisplay}}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
      </Grid>
      <Expander IsExpanded="{Binding Owner.IsLibrarySettingsExpanded}" Header="库设置" Classes="LibrarySettingsExpander" AutomationProperties.Name="库设置">
        <StackPanel Spacing="4">
          <TextBlock Text="侧栏宽度" Classes="Caption" />
          <Slider Value="{Binding Owner.LibraryPaneWidth}" Minimum="340" Maximum="600" AutomationProperties.Name="侧栏宽度" />
          <Grid ColumnDefinitions="*,Auto">
            <CheckBox Content="包含子目录" IsChecked="{Binding Owner.Browser.IncludeSubdirectories}" />
            <Button Grid.Column="1" Content="刷新" Command="{Binding Owner.Browser.RefreshCommand}" Classes="CompactButton" />
          </Grid>
        <Border Classes="LibrarySection">
          <StackPanel Spacing="5">
            <TextBlock Text="历史管理" Classes="FieldLabel" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <Button Grid.Column="0" Content="清除所选历史"
                      Command="{Binding Owner.ClearSelectedHistoryCommand}" Classes="CompactButton" />
              <Button Grid.Column="1" Content="清空全部历史"
                      Command="{Binding Owner.RequestClearAllHistoryCommand}" Classes="CompactButton" />
            </Grid>
            <Border IsVisible="{Binding Owner.ShowClearHistoryConfirmation}"
                    BorderBrush="{DynamicResource AppWarningBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
              <StackPanel Spacing="5">
                <TextBlock Text="确定清空全部播放历史？此操作无法撤销。" Classes="Caption" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <Button Grid.Column="0" Content="取消"
                          Command="{Binding Owner.CancelClearAllHistoryCommand}" Classes="CompactButton" />
                  <Button Grid.Column="1" Content="确认清空"
                          Command="{Binding Owner.ConfirmClearAllHistoryCommand}" Classes="CompactButton accent" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
