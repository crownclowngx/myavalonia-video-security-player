<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:encryption="clr-namespace:VideoSecurityPlayer.Views.SecretVideoPlayer.Encryption"
             xmlns:vm="clr-namespace:VideoSecurityPlayer.ViewModels.SecretVideoPlayer"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="760"
             x:Class="VideoSecurityPlayer.Views.SecretVideoPlayer.VideoEncryptorView"
             x:DataType="vm:VideoEncryptorViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://VideoSecurityPlayer.Plugin/Styles/VideoDocumentStyles.axaml" />
  </UserControl.Styles>
  <Grid Classes="DocumentPage" RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Classes="DocumentHeader">
      <StackPanel Spacing="2">
        <TextBlock Text="SECVID03 批量视频加密" Classes="PageTitle" />
        <TextBlock Text="严格顺序处理；标题和描述属于公开信息；任何策略都不会覆盖已有文件。"
                   Classes="Caption" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <encryption:EncryptionQueueView Grid.Row="1" DataContext="{Binding Queue}" />
    <encryption:EncryptionExecutionView Grid.Row="2" DataContext="{Binding Batch}" />
  </Grid>
</UserControl>
