<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:encryption="clr-namespace:VideoSecurityPlayer.Views.SecretVideoPlayer.Encryption"
             xmlns:vm="clr-namespace:VideoSecurityPlayer.ViewModels.SecretVideoPlayer.Encryption"
             xmlns:operation="clr-namespace:VideoSecurityPlayer.Business.SecretVideoPlayer.Operations"
             xmlns:item="clr-namespace:VideoSecurityPlayer.ViewModels.SecretVideoPlayer"
             x:Class="VideoSecurityPlayer.Views.SecretVideoPlayer.Encryption.EncryptionQueueView"
             x:DataType="vm:EncryptionQueueViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid x:Name="QueueLayout" RowDefinitions="Auto,Auto,Auto,Auto,*">
    <Border Grid.Row="0" Classes="DocumentToolbar">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <WrapPanel Grid.Column="0">
          <Button Content="添加视频" Click="OnBrowseFileClick"
                  IsEnabled="{Binding !Owner.IsBusy}" Classes="CompactButton accent DocumentActionButton" />
          <Button Content="添加目录" Click="OnAddDirectoryClick" IsEnabled="{Binding !Owner.IsBusy}" Classes="CompactButton DocumentActionButton" />
          <Button Content="移除当前项" Command="{Binding Owner.RemoveSelectedCommand}" Classes="CompactButton DocumentActionButton" />
          <Button Content="重试当前项" Command="{Binding Owner.RetrySelectedCommand}" Classes="CompactButton DocumentActionButton" />
          <Button Content="重试全部" Command="{Binding Owner.RetryAllCommand}" Classes="CompactButton DocumentActionButton" />
          <Button Content="清除完成记录" Command="{Binding Owner.ClearCompletedCommand}" Classes="CompactButton DocumentActionButton" />
        </WrapPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding Owner.ItemCount, StringFormat='{}{0} 个文件'}" Classes="Caption" />
          <ProgressBar Width="72" Classes="ThinProgress" IsIndeterminate="True"
                       IsVisible="{Binding Owner.IsPreflighting}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1">
      <encryption:EncryptionOptionsView DataContext="{Binding Owner.Batch}" />
      <Expander Header="批量输出与描述（可用 Ctrl / Shift 多选）">
        <StackPanel Spacing="5" Margin="8" IsEnabled="{Binding !Owner.IsBusy}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
            <TextBox Text="{Binding Owner.UnifiedOutputDirectory}" PlaceholderText="统一输出目录；留空时新文件输出在源文件旁" Classes="CompactInput" />
            <Button Grid.Column="1" Content="选择目录" Click="OnChooseOutputDirectoryClick" Classes="CompactButton" />
          </Grid>
          <WrapPanel>
            <CheckBox Content="保留导入目录结构" IsChecked="{Binding Owner.PreserveDirectories}" />
            <Button Content="应用到所选" Click="OnApplySelectedOutputClick" Classes="CompactButton DocumentActionButton" />
            <Button Content="应用到全部未完成项" Click="OnApplyAllOutputClick" Classes="CompactButton DocumentActionButton" />
            <Button Content="打开输出目录" Click="OnOpenOutputDirectoryClick" Classes="CompactButton" />
          </WrapPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
            <TextBox Text="{Binding Owner.BatchDescription}" PlaceholderText="统一公开描述" Classes="CompactInput" />
            <Button Grid.Column="1" Content="描述应用到所选" Click="OnApplyDescriptionClick" Classes="CompactButton" />
          </Grid>
        </StackPanel>
      </Expander>
    </StackPanel>

    <StackPanel Grid.Row="3" Margin="4" Spacing="3">
      <WrapPanel>
        <CheckBox Content="仅失败 / 取消" IsChecked="{Binding Owner.ShowOnlyFailures}" Margin="0,0,10,0" />
        <CheckBox Content="包括子目录" IsChecked="{Binding Owner.Input.IncludeSubdirectories}" IsEnabled="{Binding !Owner.IsBusy}" />
        <Button Content="取消导入" Command="{Binding Owner.Input.CancelImportCommand}" IsVisible="{Binding Owner.Input.IsCollecting}" Classes="CompactButton" />
      </WrapPanel>
      <TextBlock Text="{Binding Owner.Input.Summary}" Classes="Caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Owner.Input.Summary}" />
    </StackPanel>

    <Border Grid.Row="2" Classes="DocumentSection"
            IsVisible="{Binding Owner.HasPreflightIssues}">
      <StackPanel Spacing="5">
        <TextBlock Text="批次级预检" Classes="SectionTitle" />
        <ScrollViewer MaxHeight="100"><ItemsControl ItemsSource="{Binding Owner.PreflightIssues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="operation:VideoPreflightIssue">
              <StackPanel Margin="0,2" Spacing="1">
                <TextBlock Text="{Binding SeverityText}" Classes="Caption" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Message}" Classes="StatusText" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SuggestedAction}" Classes="Caption" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl></ScrollViewer>
      </StackPanel>
    </Border>

    <Grid x:Name="QueueArea" Grid.Row="4" Height="140" ColumnDefinitions="3*,2*" ColumnSpacing="8" MinHeight="140">
      <Grid Grid.Column="0">
        <ListBox x:Name="QueueList" SelectionMode="Multiple" Classes="DocumentQueue" ItemsSource="{Binding Owner.VisibleItems}" SelectedItem="{Binding Owner.SelectedItem}"
                 IsVisible="{Binding Owner.HasItems}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="item:EncryptionQueueItemViewModel">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="5,4" RowSpacing="2">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FileName}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding InputPath}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.StateText}"
                           FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding RequestedOutputPath}"
                           Classes="Caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RequestedOutputPath}" />
                <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Minimum="0" Maximum="100"
                             Value="{Binding Status.Progress}" Height="3" IsVisible="{Binding Status.IsRunning}" />
                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Status.Message}"
                           IsVisible="{Binding Status.HasMessage}" Classes="Caption"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status.Message}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Classes="EmptyState" IsVisible="{Binding !Owner.HasItems}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
            <PathIcon Classes="EmptyStateIcon" Data="{StaticResource VideoQueueGeometry}" />
            <TextBlock Text="队列为空" HorizontalAlignment="Center" Classes="SectionTitle" />
            <TextBlock Text="添加或拖入视频、目录开始批量加密"
                       HorizontalAlignment="Center" Classes="Caption" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Column="1" Classes="DocumentInspector" IsVisible="{Binding Owner.HasSelectedItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Owner.SelectedItem}">
          <StackPanel x:DataType="item:EncryptionQueueItemViewModel" Spacing="7">
            <WrapPanel IsVisible="{Binding Status.HasOutputPath}">
              <Button Content="定位文件" Tag="{Binding Status.OutputPath}" Click="OnLocateOutputClick" Classes="CompactButton" />
              <Button Content="复制路径" Tag="{Binding Status.OutputPath}" Click="OnCopyOutputClick" Classes="CompactButton" />
            </WrapPanel>
            <TextBlock Text="所选项目" Classes="SectionTitle" />
            <TextBlock Text="输出路径" Classes="Caption" />
            <TextBox IsReadOnly="{Binding Status.IsSucceeded}" Text="{Binding RequestedOutputPath}" Classes="CompactInput"
                     IsEnabled="{Binding !$parent[UserControl].((vm:EncryptionQueueViewModel)DataContext).Owner.IsBusy}"
                     ToolTip.Tip="{Binding RequestedOutputPath}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="公开标题（可留空）" Classes="Caption" />
              <TextBlock Grid.Column="1" Text="{Binding TitleCharacterCount, StringFormat='{}{0} / 200'}" Classes="Caption" />
            </Grid>
            <TextBox IsReadOnly="{Binding Status.IsSucceeded}" Text="{Binding PublicTitle}" Classes="CompactInput"
                     IsEnabled="{Binding !$parent[UserControl].((vm:EncryptionQueueViewModel)DataContext).Owner.IsBusy}"
                     PlaceholderText="留空时播放器显示原始文件名" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="公开描述（可留空）" Classes="Caption" />
              <TextBlock Grid.Column="1" Text="{Binding DescriptionCharacterCount, StringFormat='{}{0} / 10000'}" Classes="Caption" />
            </Grid>
            <TextBox IsReadOnly="{Binding Status.IsSucceeded}" Text="{Binding PublicDescription}" Classes="CompactInput" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="100" MaxHeight="180"
                     IsEnabled="{Binding !$parent[UserControl].((vm:EncryptionQueueViewModel)DataContext).Owner.IsBusy}" />
            <TextBlock Text="{Binding Status.FailureCodeText}"
                       IsVisible="{Binding Status.HasFailureCode}" Classes="Caption" />
            <TextBlock Text="{Binding PreparedOutputPath}" Classes="Caption" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
  </ScrollViewer>
</UserControl>
