<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VideoSecurityPlayer.ViewModels.SecretVideoPlayer.Playback"
             x:Class="VideoSecurityPlayer.Views.SecretVideoPlayer.Playback.PlaybackDeploymentView"
             x:DataType="vm:PlaybackDeploymentViewModel">
  <Border IsVisible="{Binding !IsPlaybackAvailable}"
          Background="{DynamicResource AppWarningPanelBrush}"
          BorderBrush="{DynamicResource AppWarningBorderBrush}" BorderThickness="1"
          CornerRadius="4" Padding="10" Margin="4,2">
    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"
          ColumnSpacing="10" RowSpacing="4">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DeploymentIssueText}"
                 FontWeight="SemiBold" TextWrapping="Wrap" />
      <Button Grid.Row="0" Grid.Column="1" Content="重新检测"
              Command="{Binding RetryDeploymentCheckCommand}" />
      <SelectableTextBlock Grid.Row="1" Grid.ColumnSpan="2"
                           Text="{Binding DeploymentCheckedPath}"
                           FontFamily="Consolas" TextWrapping="Wrap" />
      <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                 Text="{Binding DeploymentSuggestedAction}" TextWrapping="Wrap" />
    </Grid>
  </Border>
</UserControl>
