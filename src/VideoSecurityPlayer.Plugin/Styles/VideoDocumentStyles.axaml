<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- 插件内共享的轻量矢量图标；均由 Avalonia 缓存，不依赖字体、图片或 SVG 文件。 -->
    <StreamGeometry x:Key="VideoChevronLeftGeometry">M11,3 L6,8 L11,13</StreamGeometry>
    <StreamGeometry x:Key="VideoChevronRightGeometry">M5,3 L10,8 L5,13</StreamGeometry>
    <StreamGeometry x:Key="VideoPlayGeometry">M4,2 L15,9 L4,16 Z</StreamGeometry>
    <StreamGeometry x:Key="VideoPauseGeometry">M4,3 H8 V15 H4 Z M11,3 H15 V15 H11 Z</StreamGeometry>
    <StreamGeometry x:Key="VideoStopGeometry">M4,4 H14 V14 H4 Z</StreamGeometry>
    <StreamGeometry x:Key="VideoPreviousGeometry">M3,3 H5 V15 H3 Z M15,3 L6,9 L15,15 Z</StreamGeometry>
    <StreamGeometry x:Key="VideoNextGeometry">M15,3 H17 V15 H15 Z M5,3 L14,9 L5,15 Z</StreamGeometry>
    <StreamGeometry x:Key="VideoFullscreenGeometry">M2,2 H7 V4 H4 V7 H2 Z M11,2 H16 V7 H14 V4 H11 Z M14,11 H16 V16 H11 V14 H14 Z M2,11 H4 V14 H7 V16 H2 Z</StreamGeometry>
    <StreamGeometry x:Key="VideoClearGeometry">M4,3 L9,8 L14,3 L15,4 L10,9 L15,14 L14,15 L9,10 L4,15 L3,14 L8,9 L3,4 Z</StreamGeometry>
    <StreamGeometry x:Key="VideoWarningGeometry">M9,2 L17,16 H1 Z M9,6 V11 M9,13.5 V14</StreamGeometry>
    <StreamGeometry x:Key="VideoQueueGeometry">M2,3 H16 V15 H2 Z M5,3 V15 M13,3 V15 M2,7 H5 M13,7 H16 M2,11 H5 M13,11 H16</StreamGeometry>
  </Styles.Resources>

  <!-- 只通过显式 Class 约束插件视觉，避免影响宿主和其他插件。 -->
  <Style Selector="Grid.DocumentPage">
    <Setter Property="Margin" Value="14" />
    <Setter Property="RowSpacing" Value="8" />
  </Style>

  <Style Selector="Border.DocumentHeader">
    <Setter Property="Padding" Value="0,0,0,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.DocumentToolbar">
    <Setter Property="Padding" Value="0,0,0,7" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.DocumentOptions">
    <Setter Property="Padding" Value="8" />
    <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <Style Selector="Border.DocumentSection">
    <Setter Property="Padding" Value="9" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.DocumentInspector">
    <Setter Property="Padding" Value="10,6,8,6" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>

  <Style Selector="Border.PlayerInfoSection">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Expander.DocumentSectionExpander">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.TaskFooter">
    <Setter Property="Padding" Value="8,7,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="TextBlock.PageTitle">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.SectionTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.Caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
  </Style>

  <Style Selector="TextBlock.StatusText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Opacity" Value="0.86" />
  </Style>

  <Style Selector="SelectableTextBlock.StatusText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Opacity" Value="0.86" />
  </Style>

  <Style Selector="Button.CompactButton">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <Style Selector="Button.DocumentActionButton">
    <Setter Property="Margin" Value="0,0,6,4" />
  </Style>

  <Style Selector="Button.IconButton">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <Style Selector="Button.FlatIconButton">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
  </Style>
  <Style Selector="Button.FlatIconButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppInfoBrush}" />
  </Style>

  <Style Selector="TextBox.CompactInput">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ComboBox.CompactInput">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="PathIcon.DocumentIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
  </Style>

  <Style Selector="PathIcon.DocumentIcon.accent">
    <Setter Property="Foreground" Value="{DynamicResource AppInfoBrush}" />
  </Style>

  <Style Selector="PathIcon.DocumentIcon.warning">
    <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
  </Style>

  <Style Selector="ProgressBar.ThinProgress">
    <Setter Property="Height" Value="3" />
  </Style>

  <Style Selector="Border.EmptyState">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="PathIcon.EmptyStateIcon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
    <Setter Property="Opacity" Value="0.58" />
  </Style>

  <Style Selector="ListBox.DocumentQueue">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.DocumentQueue ListBoxItem">
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <Style Selector="ListBox.DocumentQueue ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
  </Style>

  <Style Selector="ListBox.DocumentQueue ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource AppToolSelectedBrush}" />
  </Style>

  <!-- 媒体库保持 VS Code Explorer 式平面分区和虚拟化列表。 -->
  <Style Selector="Border.LibraryPaneRail">
    <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Border.LibrarySection">
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.LibraryListSection">
    <Setter Property="Padding" Value="7" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Expander.LibrarySettingsExpander">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="TextBlock.FieldLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
  </Style>

  <Style Selector="TextBlock.LibraryHint">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
  </Style>

  <Style Selector="ListBox.LibraryList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.LibraryList ListBoxItem">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <Style Selector="ListBox.LibraryList ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
  </Style>

  <Style Selector="ListBox.LibraryList ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource AppToolSelectedBrush}" />
  </Style>
</Styles>
