<Project><Target Name="CopyVideoRuntimeForTools" AfterTargets="Build" Condition="'$(ManagedPlugin)' != 'true' and Exists('$(MSBuildThisFileDirectory)src/VideoSecurityPlayer.Plugin/bin/$(Configuration)/net10.0/native/win-x64/libvlc')"><ItemGroup><VideoRuntime Include="$(MSBuildThisFileDirectory)src/VideoSecurityPlayer.Plugin/bin/$(Configuration)/net10.0/native/win-x64/libvlc/**/*" /></ItemGroup><Copy SourceFiles="@(VideoRuntime)" DestinationFiles="@(VideoRuntime->'$(TargetDir)native/win-x64/libvlc/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" /></Target></Project>